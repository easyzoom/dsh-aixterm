{
  "name": "dsh-aixterm",
  "version": "0.1.0",
  "description": "SSH/SFTP session manager and terminal for DeepSeek Harness, shared by the human and the AI agent.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "slots"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "docs/diagnostic-profiles.md",
    "docs/diagnostic-profile.schema.json",
    "docs/examples",
    "docs/images",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "ssh",
    "sftp",
    "terminal",
    "session"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/easyzoom/dsh-aixterm.git"
  },
  "homepage": "https://github.com/easyzoom/dsh-aixterm#readme",
  "bugs": {
    "url": "https://github.com/easyzoom/dsh-aixterm/issues"
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "prepack": "node scripts/build-client.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "node-pty": "1.2.0-beta.18",
    "serialport": "^13.0.0",
    "ssh2": "^1.17.0",
    "string-width": "^7.2.0",
    "zmodem.js": "^0.1.10"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1",
    "@deepseek-ai/schemastery": "^3.18.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "esbuild": "^0.28.2"
  }
}
